---
import { site } from "../data/site";
import SocialLinks from "./SocialLinks.astro";
---

<section class="relative overflow-hidden">
  <!-- Subtle accent backdrop -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(60%_50%_at_50%_0%,var(--color-accent-soft)_0%,transparent_70%)]"
  >
  </div>

  <div class="mx-auto max-w-5xl px-6 py-24 sm:py-32">
    <p class="font-mono text-sm text-accent-dark">
      <span class="text-accent">$</span> whoami
    </p>

    <h1
      class="mt-4 text-4xl font-bold tracking-tight text-zinc-900 sm:text-6xl"
    >
      {site.name}
    </h1>

    <p class="mt-4 text-xl text-zinc-700 sm:text-2xl">
      {site.role} specialized in{" "}
      <span class="font-semibold text-accent-dark">Golang</span> &amp;{" "}
      <span class="font-semibold text-accent-dark">PHP</span>
    </p>

    <p class="mt-6 max-w-2xl text-base leading-relaxed text-zinc-600 sm:text-lg">
      {site.tagline}
    </p>

    <p class="mt-6 flex items-center gap-2 text-sm text-zinc-500">
      <svg
        class="size-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
        <circle cx="12" cy="10" r="3"></circle>
      </svg>
      {site.location}
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a
        href="#contact"
        class="inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-accent-dark"
      >
        Get in touch
      </a>
      <a
        href={site.resumeUrl}
        download
        class="inline-flex items-center gap-2 rounded-lg border border-zinc-300 px-5 py-2.5 text-sm font-medium text-zinc-800 transition-colors hover:border-accent hover:text-accent-dark"
      >
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        Download CV
      </a>
      <SocialLinks class="ml-1" />
    </div>
  </div>
</section>
