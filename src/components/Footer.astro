---
import { site } from "../data/site";
import SocialLinks from "./SocialLinks.astro";

const year = new Date().getFullYear();
---

<footer class="border-t border-zinc-200 bg-zinc-50">
  <div
    class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 px-6 py-10 sm:flex-row"
  >
    <p class="text-sm text-zinc-500">
      © {year} {site.name}. Built with{" "}
      <a
        href="https://astro.build"
        target="_blank"
        rel="noopener"
        class="font-medium text-zinc-600 hover:text-accent-dark">Astro</a
      >.
    </p>
    <SocialLinks />
  </div>
</footer>
