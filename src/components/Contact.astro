---
import Section from "./Section.astro";
import SocialLinks from "./SocialLinks.astro";
import { site } from "../data/site";

const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID;
const formAction = formspreeId ? `https://formspree.io/f/${formspreeId}` : null;

const inputClass =
  "w-full rounded-xl border border-line bg-white/5 px-4 py-3 text-sm text-ink placeholder:text-muted/70 transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/25";
---

<Section id="contact" label="05 — Contact" title="Let's build something">
  <div class="grid gap-12 lg:grid-cols-5">
    <div class="reveal lg:col-span-2">
      <p class="text-base leading-relaxed text-muted sm:text-lg">
        Looking for a backend engineer for your team or project? I'm always
        happy to talk about Go, PHP, and scalable systems.
      </p>

      <a
        href={`mailto:${site.email}`}
        class="mt-6 inline-flex items-center gap-2 font-medium text-ink transition-colors hover:text-accent"
      >
        <svg
          class="size-5 text-accent"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="2" y="4" width="20" height="16" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
        {site.email}
      </a>

      <p class="mt-2 flex items-center gap-2 text-sm text-muted">
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        {site.location}
      </p>

      <div class="mt-6">
        <SocialLinks />
      </div>
    </div>

    <div class="reveal lg:col-span-3">
      {
        formAction ? (
          <form id="contact-form" action={formAction} method="POST" class="space-y-4">
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="name" class="mb-1.5 block text-sm font-medium text-ink">
                  Name
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  autocomplete="name"
                  class={inputClass}
                  placeholder="Jane Doe"
                />
              </div>
              <div>
                <label for="email" class="mb-1.5 block text-sm font-medium text-ink">
                  Email
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  autocomplete="email"
                  class={inputClass}
                  placeholder="jane@company.com"
                />
              </div>
            </div>
            <div>
              <label for="message" class="mb-1.5 block text-sm font-medium text-ink">
                Message
              </label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                class={`${inputClass} resize-y`}
                placeholder="Tell me a bit about what you're working on…"
              />
            </div>
            <button
              type="submit"
              class="inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-accent to-accent-2 px-6 py-3 text-sm font-semibold text-night shadow-[0_0_30px_rgba(34,211,238,0.22)] transition-shadow hover:shadow-[0_0_42px_rgba(167,139,250,0.4)] disabled:cursor-not-allowed disabled:opacity-60"
            >
              <span data-label>Send message</span>
            </button>
            <p
              id="form-status"
              role="status"
              aria-live="polite"
              class="hidden text-sm"
            />
          </form>
        ) : (
          <div class="ring-gradient rounded-2xl p-6">
            <p class="text-sm text-muted">
              The contact form isn't configured yet. The quickest way to reach me
              is by email:
            </p>
            <a
              href={`mailto:${site.email}`}
              class="mt-4 inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-accent to-accent-2 px-6 py-3 text-sm font-semibold text-night transition-shadow hover:shadow-[0_0_42px_rgba(167,139,250,0.4)]"
            >
              Email me
            </a>
          </div>
        )
      }
    </div>
  </div>
</Section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  if (form) {
    const status = form.querySelector<HTMLParagraphElement>("#form-status");
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    const label = form.querySelector<HTMLElement>("[data-label]");

    const setStatus = (message: string, ok: boolean) => {
      if (!status) return;
      status.textContent = message;
      status.classList.remove("hidden", "text-emerald-400", "text-red-400");
      status.classList.add(ok ? "text-emerald-400" : "text-red-400");
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (button) button.disabled = true;
      if (label) label.textContent = "Sending…";

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });

        if (response.ok) {
          form.reset();
          setStatus("Thanks! Your message has been sent. I'll get back to you soon.", true);
        } else {
          setStatus("Something went wrong. Please email me directly instead.", false);
        }
      } catch {
        setStatus("Network error. Please email me directly instead.", false);
      } finally {
        if (button) button.disabled = false;
        if (label) label.textContent = "Send message";
      }
    });
  }
</script>
