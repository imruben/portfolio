---
import { site, navLinks } from "../data/site";
---

<header
  class="sticky top-0 z-50 border-b border-zinc-200/80 bg-white/80 backdrop-blur-md"
>
  <nav
    class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4"
    aria-label="Primary"
  >
    <a
      href="#top"
      class="font-mono text-sm font-semibold tracking-tight text-zinc-900 hover:text-accent-dark"
    >
      <span class="text-accent">&gt;</span> {site.name}
    </a>

    <!-- Desktop nav -->
    <ul class="hidden items-center gap-7 md:flex">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-sm text-zinc-600 transition-colors hover:text-accent-dark"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={site.resumeUrl}
          download
          class="rounded-lg border border-zinc-300 px-3 py-1.5 text-sm font-medium text-zinc-800 transition-colors hover:border-accent hover:text-accent-dark"
        >
          Résumé
        </a>
      </li>
    </ul>

    <!-- Mobile toggle -->
    <button
      id="menu-toggle"
      type="button"
      class="inline-flex items-center justify-center rounded-lg p-2 text-zinc-700 hover:bg-zinc-100 md:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Toggle navigation menu"
    >
      <svg
        class="size-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-zinc-200 md:hidden">
    <ul class="space-y-1 px-6 py-4">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="block rounded-lg px-2 py-2 text-sm text-zinc-700 hover:bg-zinc-100 hover:text-accent-dark"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={site.resumeUrl}
          download
          class="block rounded-lg px-2 py-2 text-sm font-medium text-accent-dark hover:bg-zinc-100"
        >
          Download Résumé
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(isOpen));
  });

  // Close the menu after tapping a link
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>
