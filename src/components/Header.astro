---
import { site, navLinks } from "../data/site";
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-300"
>
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4"
    aria-label="Primary"
  >
    <a
      href="#top"
      class="font-mono text-sm font-semibold tracking-tight text-ink transition-colors hover:text-accent"
    >
      <span class="text-gradient">&gt;_</span>
      {site.firstName}
    </a>

    <!-- Desktop nav -->
    <ul class="hidden items-center gap-8 md:flex">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-sm text-muted transition-colors hover:text-ink"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={site.resumeUrl}
          download
          class="rounded-lg border border-line bg-white/5 px-3.5 py-1.5 text-sm font-medium text-ink transition-colors hover:border-accent/60 hover:text-accent"
        >
          Résumé
        </a>
      </li>
    </ul>

    <!-- Mobile toggle -->
    <button
      id="menu-toggle"
      type="button"
      class="inline-flex items-center justify-center rounded-lg p-2 text-ink hover:bg-white/5 md:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Toggle navigation menu"
    >
      <svg
        class="size-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden border-t border-line bg-night/95 backdrop-blur-xl md:hidden"
  >
    <ul class="space-y-1 px-6 py-4">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="block rounded-lg px-2 py-2 text-sm text-muted hover:bg-white/5 hover:text-ink"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={site.resumeUrl}
          download
          class="block rounded-lg px-2 py-2 text-sm font-medium text-accent hover:bg-white/5"
        >
          Download Résumé
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  // Glass background once scrolled
  const header = document.getElementById("site-header");
  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 16) {
      header.classList.add(
        "border-b",
        "border-line",
        "bg-night/80",
        "backdrop-blur-xl",
      );
    } else {
      header.classList.remove(
        "border-b",
        "border-line",
        "bg-night/80",
        "backdrop-blur-xl",
      );
    }
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  // Mobile menu
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(isOpen));
  });
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>
