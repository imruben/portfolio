---
import Section from "./Section.astro";
import { experience, education } from "../data/experience";
---

<Section id="experience" label="03 — Experience" title="Where I've worked">
  <ol
    class="relative space-y-6 before:absolute before:bottom-3 before:left-[7px] before:top-3 before:w-px before:bg-gradient-to-b before:from-accent before:via-accent-2 before:to-transparent"
  >
    {
      experience.map((role, i) => {
        const isCurrent = role.end === "Present";
        return (
          <li
            class="reveal relative pl-9"
            style={`transition-delay:${i * 90}ms`}
          >
            <span
              class:list={[
                "absolute left-0 top-3 size-3.5 rounded-full border-2 border-night",
                isCurrent
                  ? "bg-accent shadow-[0_0_0_4px_rgba(34,211,238,0.25)]"
                  : "bg-line",
              ]}
            />
            <div
              class:list={[
                "rounded-2xl p-6",
                isCurrent
                  ? "ring-gradient"
                  : "border border-line bg-surface",
              ]}
            >
              <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                <h3 class="text-lg font-semibold text-ink">
                  {role.title}
                  <span class="text-accent"> · {role.company}</span>
                </h3>
                <div class="flex items-center gap-2">
                  {isCurrent && (
                    <span class="inline-flex items-center gap-1.5 rounded-full border border-accent/40 bg-accent-soft px-2.5 py-0.5 font-mono text-[11px] font-medium text-accent">
                      <span class="size-1.5 rounded-full bg-accent" />
                      Current
                    </span>
                  )}
                  <p class="font-mono text-xs text-muted">
                    {role.start} – {role.end}
                  </p>
                </div>
              </div>

              <p class="mt-1 text-sm text-muted">
                {role.location}
                {role.arrangement && ` · ${role.arrangement}`}
              </p>

              <ul class="mt-4 space-y-2">
                {role.highlights.map((point) => (
                  <li class="flex gap-2.5 text-sm leading-relaxed text-muted sm:text-base">
                    <span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent/70" />
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        );
      })
    }
  </ol>

  <div class="reveal mt-12">
    <h3
      class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-accent"
    >
      Education
    </h3>
    {
      education.map((ed) => (
        <div class="flex flex-col gap-1 rounded-xl border border-line bg-surface p-5 sm:flex-row sm:items-baseline sm:justify-between">
          <p class="font-medium text-ink">
            {ed.school}
            <span class="font-normal text-muted"> — {ed.program}</span>
          </p>
          <p class="font-mono text-xs text-muted">{ed.period}</p>
        </div>
      ))
    }
  </div>
</Section>
