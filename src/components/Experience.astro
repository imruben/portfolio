---
import Section from "./Section.astro";
import { experience, education } from "../data/experience";
---

<Section id="experience" label="03 — Experience" title="Where I've worked">
  <ol class="relative space-y-10 border-l border-zinc-200 pl-8">
    {
      experience.map((role) => (
        <li class="relative">
          <span class="absolute -left-[2.55rem] top-1.5 size-3 rounded-full border-2 border-white bg-accent ring-1 ring-zinc-200" />

          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="text-lg font-semibold text-zinc-900">
              {role.title}{" "}
              <span class="text-accent-dark">· {role.company}</span>
            </h3>
            <p class="font-mono text-xs text-zinc-500">
              {role.start} – {role.end}
            </p>
          </div>

          <p class="mt-1 text-sm text-zinc-500">
            {role.location}
            {role.arrangement && ` · ${role.arrangement}`}
          </p>

          <ul class="mt-3 space-y-2">
            {role.highlights.map((point) => (
              <li class="flex gap-2 text-sm leading-relaxed text-zinc-600 sm:text-base">
                <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-accent/60" />
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>

  <div class="mt-12">
    <h3 class="mb-4 font-mono text-sm text-accent-dark">Education</h3>
    {
      education.map((ed) => (
        <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
          <p class="text-base font-medium text-zinc-900">
            {ed.school}
            <span class="font-normal text-zinc-600"> — {ed.program}</span>
          </p>
          <p class="font-mono text-xs text-zinc-500">{ed.period}</p>
        </div>
      ))
    }
  </div>
</Section>
