---
import { languageColor, type Repo } from "../lib/github";

interface Props {
  repo: Repo;
}

const { repo } = Astro.props;
---

<a
  href={repo.url}
  target="_blank"
  rel="noopener"
  class="group flex h-full flex-col rounded-xl border border-zinc-200 bg-white p-5 transition-all hover:-translate-y-0.5 hover:border-accent hover:shadow-md"
>
  <div class="flex items-start justify-between gap-3">
    <h3
      class="font-mono text-base font-semibold text-zinc-900 group-hover:text-accent-dark"
    >
      {repo.name}
    </h3>
    <svg
      class="size-4 shrink-0 text-zinc-400 transition-colors group-hover:text-accent"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M7 17 17 7"></path>
      <path d="M7 7h10v10"></path>
    </svg>
  </div>

  <p class="mt-2 flex-1 text-sm leading-relaxed text-zinc-600">
    {repo.description ?? "No description provided."}
  </p>

  {
    repo.topics.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-1.5">
        {repo.topics.slice(0, 4).map((topic) => (
          <li class="rounded-md bg-accent-soft px-2 py-0.5 font-mono text-xs text-accent-dark">
            {topic}
          </li>
        ))}
      </ul>
    )
  }

  <div class="mt-4 flex items-center gap-4 text-xs text-zinc-500">
    {
      repo.language && (
        <span class="flex items-center gap-1.5">
          <span
            class="size-2.5 rounded-full"
            style={`background-color: ${languageColor(repo.language)}`}
          />
          {repo.language}
        </span>
      )
    }
    {
      repo.stars > 0 && (
        <span class="flex items-center gap-1">
          <svg
            class="size-3.5"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M12 2.5l2.95 5.98 6.6.96-4.77 4.65 1.13 6.57L12 17.55l-5.9 3.1 1.12-6.56L2.45 9.44l6.6-.96L12 2.5z" />
          </svg>
          {repo.stars}
        </span>
      )
    }
  </div>
</a>
