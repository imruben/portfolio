---
import { languageColor, type Repo } from "../lib/github";

interface Props {
  repo: Repo;
  index?: number;
}

const { repo, index = 0 } = Astro.props;
---

<a
  href={repo.url}
  target="_blank"
  rel="noopener"
  style={`transition-delay:${index * 60}ms`}
  class="reveal group flex h-full flex-col rounded-2xl border border-line bg-surface p-6 transition-all duration-300 hover:-translate-y-1 hover:border-accent/50 hover:shadow-[0_10px_44px_rgba(34,211,238,0.14)]"
>
  <div class="flex items-start justify-between gap-3">
    <div class="flex items-center gap-2.5">
      <span
        class="ring-gradient flex size-9 items-center justify-center rounded-lg text-accent"
      >
        <svg
          class="size-4.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
        </svg>
      </span>
      <h3
        class="font-mono text-base font-semibold text-ink group-hover:text-accent"
      >
        {repo.name}
      </h3>
    </div>
    <svg
      class="size-4 shrink-0 text-muted transition-all group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M7 17 17 7"></path>
      <path d="M7 7h10v10"></path>
    </svg>
  </div>

  <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">
    {repo.description ?? "No description provided."}
  </p>

  {
    repo.topics.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-1.5">
        {repo.topics.slice(0, 4).map((topic) => (
          <li class="rounded-md border border-line bg-white/5 px-2 py-0.5 font-mono text-xs text-muted">
            {topic}
          </li>
        ))}
      </ul>
    )
  }

  <div class="mt-5 flex items-center gap-4 text-xs text-muted">
    {
      repo.language && (
        <span class="flex items-center gap-1.5">
          <span
            class="size-2.5 rounded-full"
            style={`background-color:${languageColor(repo.language)}`}
          />
          {repo.language}
        </span>
      )
    }
    {
      repo.stars > 0 && (
        <span class="flex items-center gap-1">
          <svg class="size-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.5l2.95 5.98 6.6.96-4.77 4.65 1.13 6.57L12 17.55l-5.9 3.1 1.12-6.56L2.45 9.44l6.6-.96L12 2.5z" />
          </svg>
          {repo.stars}
        </span>
      )
    }
    {
      repo.forks > 0 && (
        <span class="flex items-center gap-1">
          <svg
            class="size-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="6" cy="6" r="2.5" />
            <circle cx="18" cy="6" r="2.5" />
            <circle cx="12" cy="18" r="2.5" />
            <path d="M6 8.5v1A2.5 2.5 0 0 0 8.5 12h7A2.5 2.5 0 0 0 18 9.5v-1M12 12v3.5" />
          </svg>
          {repo.forks}
        </span>
      )
    }
  </div>
</a>
