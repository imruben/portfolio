---
import Section from "./Section.astro";
import { skills } from "../data/skills";
---

<Section id="skills" label="02 — Skills" title="My tech stack" alt>
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      skills.map((group, i) => (
        <div
          class="reveal group rounded-2xl border border-line bg-surface p-6 transition-colors duration-300 hover:border-accent/40"
          style={`transition-delay:${i * 70}ms`}
        >
          <h3 class="mb-4 flex items-center gap-2 font-mono text-sm font-medium text-ink">
            <span class="text-gradient">{String(i + 1).padStart(2, "0")}</span>
            {group.category}
          </h3>
          <ul class="flex flex-wrap gap-2">
            {group.items.map((item) => (
              <li class="rounded-lg border border-line bg-white/5 px-3 py-1.5 text-sm text-muted transition-colors hover:border-accent/40 hover:text-accent">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
