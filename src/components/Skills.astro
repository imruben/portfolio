---
import Section from "./Section.astro";
import { skills } from "../data/skills";
---

<Section id="skills" label="02 — Skills" title="Tech stack" alt>
  <div class="grid gap-8 sm:grid-cols-2">
    {
      skills.map((group) => (
        <div>
          <h3 class="mb-3 font-mono text-sm font-medium text-zinc-500">
            {group.category}
          </h3>
          <ul class="flex flex-wrap gap-2">
            {group.items.map((item) => (
              <li class="rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium text-zinc-800 transition-colors hover:border-accent hover:text-accent-dark">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
