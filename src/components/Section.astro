---
interface Props {
  id: string;
  label: string;
  title: string;
  alt?: boolean;
}

const { id, label, title, alt = false } = Astro.props;
---

<section
  id={id}
  class:list={[
    "py-24 sm:py-28",
    alt && "border-y border-line bg-white/[0.015]",
  ]}
>
  <div class="mx-auto max-w-6xl px-6">
    <header class="reveal mb-12 max-w-2xl">
      <p
        class="font-mono text-xs uppercase tracking-[0.22em] text-accent"
      >
        {label}
      </p>
      <h2
        class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl"
      >
        {title}
      </h2>
    </header>
    <slot />
  </div>
</section>
